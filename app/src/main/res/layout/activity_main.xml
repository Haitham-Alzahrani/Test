<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flight Search Alert"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/gold_dark"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-search and alert when flights are available"
            android:textSize="14sp"
            android:textColor="@color/gray_text"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/circle_indicator" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvSearchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search attempts: 0"
                    android:textSize="14sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvLastResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last result: -"
                    android:textSize="14sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Log Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activity Log"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="200dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waiting to start..."
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/gray_text" />

                </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Delay Setting -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retry delay (seconds)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/seekDelay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="3"
                        android:max="30"
                        android:progress="5" />

                    <TextView
                        android:id="@+id/tvDelay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5s"
                        android:textSize="16sp"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Enable Accessibility Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnableService"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/enable_service"
            android:textSize="16sp"
            android:backgroundTint="@color/gold_dark"
            android:layout_marginBottom="12dp" />

        <!-- Start/Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/start_monitoring"
            android:textSize="16sp"
            android:backgroundTint="@color/gold"
            android:layout_marginBottom="12dp" />

        <!-- Stop Alarm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopAlarm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Stop Alarm"
            android:textSize="16sp"
            android:backgroundTint="@color/red_alert"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to use:\n1. Tap 'Enable Accessibility Service'\n2. Enable 'Flight Search Alert' in settings\n3. Open your flight booking app\n4. Navigate to the search page\n5. Tap 'Start Monitoring'\n6. Switch to the flight app - it will auto-search"
            android:textSize="13sp"
            android:textColor="@color/gray_text"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

</ScrollView>
