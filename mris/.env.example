# Copy to .env and fill in what you have. Every provider is optional, but without
# metadata + web research providers MRIS can only work with evidence you add manually
# (`mris research add-evidence`). It never invents data to fill the gaps.

# SQLite database location (relative paths are resolved from the project root)
MRIS_DB_PATH=data/mris.db
MRIS_BACKUP_DIR=data/backups
MRIS_BACKUP_KEEP=20

# The Movie Database (https://www.themoviedb.org/settings/api) - discovery + verified metadata.
# Either the v3 API key or the v4 read access token works.
MRIS_TMDB_API_KEY=

# OMDb (https://www.omdbapi.com/apikey.aspx) - IMDb / Rotten Tomatoes / Metacritic ratings.
MRIS_OMDB_API_KEY=

# Web search used for reviews, audience reaction, pacing / opening evidence.
# One of: brave, tavily, none
MRIS_SEARCH_PROVIDER=none
MRIS_BRAVE_API_KEY=
MRIS_TAVILY_API_KEY=
# Download result pages and analyse their full text (in addition to snippets)
MRIS_FETCH_PAGES=true

# Systematic search range (newest year first, January -> December inside each year)
MRIS_SEARCH_START_YEAR=2026
MRIS_SEARCH_END_YEAR=2010
MRIS_MIN_VOTE_COUNT=15
MRIS_MAX_DISCOVERY_PAGES=5
# Safety cap per "continue" run. The cursor is saved, so the next run resumes exactly here.
MRIS_MAX_CANDIDATES_PER_RUN=150

# Scoring thresholds
MRIS_PASS_THRESHOLD=75
MRIS_REJECT_THRESHOLD=55

# HTTP
MRIS_HTTP_TIMEOUT=20
MRIS_WEB_REQUEST_DELAY=1.1
MRIS_MAX_RESULTS_PER_QUERY=6
